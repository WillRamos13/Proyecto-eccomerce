# Copia este archivo como .env y reemplaza TODOS los valores marcados.
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fastmarket
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Seguridad: usa valores aleatorios, no reutilices estos textos.
APP_AUTH_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@fastmarket.com
ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_ADMIN_SEGURA
ADMIN_RESET_PASSWORD=false

# URLs públicas. El frontend debe publicarse como raíz, no dentro de /frontend.
FRONTEND_BASE_URL=http://localhost:5500
BACKEND_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5500,http://127.0.0.1:5500

# Pagos
MERCADOPAGO_ACCESS_TOKEN=
PAGO_RESERVA_MINUTOS=30

# Integraciones opcionales
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM=FastMarket <correo@dominio.com>
