digraph FastMarketResumen {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, splines=ortho, fontname="Arial", label="FastMarket - Diagrama UML resumido de clases y patrones", labelloc=t, fontsize=20];
  node [shape=record, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.12,0.08", color="#D96D00", fillcolor="#FFF4E8"];
  edge [fontname="Arial", fontsize=9, color="#4B5563", arrowsize=0.75];

  subgraph cluster_domain {
    label="Dominio y persistencia"; color="#F4A261"; style="rounded";
    Usuario [label="{Usuario|id; nombre; correo; rol}"];
    Producto [label="{Producto|id; nombre; precio; stock|+actualizarStock()}"];
    Pedido [label="{Pedido|codigo; fecha; estado; total|+getItems()}"];
    Item [label="{PedidoItem|cantidad; precioUnitario; subtotal}"];
    Historial [label="{PedidoHistorial|estadoAnterior; estadoNuevo; fecha}"];
    Cupon [label="{Cupon|codigo; tipo; valor; vigencia}"];
    Usuario -> Pedido [label="1 crea *"];
    Pedido -> Item [label="1 contiene *", arrowhead=diamond];
    Item -> Producto [label="referencia"];
    Pedido -> Historial [label="1 registra *", arrowhead=diamond];
    Pedido -> Cupon [label="0..1 aplica", style=dashed];
  }

  subgraph cluster_app {
    label="Aplicación"; color="#E9B949"; style="rounded";
    PedidoController [label="{PedidoController|+crear(); +actualizarEstado()}", fillcolor="#FFF7D6", color="#B77900"];
    PedidoService [label="{PedidoService|+crear(); +actualizarEstado()}", fillcolor="#FFF7D6", color="#B77900"];
    MercadoPagoService [label="{MercadoPagoService|+crearPreferencia()}", fillcolor="#FFF7D6", color="#B77900"];
    ReporteService [label="{ReporteService|+generar()}", fillcolor="#FFF7D6", color="#B77900"];
    PedidoController -> PedidoService [label="delega"];
  }

  subgraph cluster_creational {
    label="Creacionales"; color="#2D6FAD"; style="rounded";
    PedidoBuilder [label="{PedidoBuilder|Builder|+nuevo(); +agregarProducto(); +conTotales(); +build()}", fillcolor="#EAF3FF", color="#2D6FAD"];
    StateFactory [label="{PedidoStateFactory|Factory|+crear(EstadoPedido)}", fillcolor="#EAF3FF", color="#2D6FAD"];
  }

  subgraph cluster_structural {
    label="Estructurales"; color="#2D9856"; style="rounded";
    Facade [label="{ComercioElectronicoFacade|Facade|+procesarPedido(); +crearPreferenciaPago()}", fillcolor="#EAF7EE", color="#2D9856"];
    Pasarela [label="{PasarelaPago|interface|+crearPreferencia(); +nombre()}", fillcolor="#EAF7EE", color="#2D9856"];
    MPAdapter [label="{MercadoPagoAdapter|Adapter|+crearPreferencia()}", fillcolor="#EAF7EE", color="#2D9856"];
    Proxy [label="{ReporteSeguroProxy|Proxy|+generar()}", fillcolor="#EAF7EE", color="#2D9856"];
    MPAdapter -> Pasarela [arrowhead=empty, style=dashed, label="implementa"];
    Facade -> PedidoService [label="coordina"];
    Facade -> MercadoPagoService [label="coordina"];
    MercadoPagoService -> Pasarela [label="depende de"];
    Proxy -> ReporteService [label="protege"];
  }

  subgraph cluster_behavioral {
    label="Comportamiento"; color="#7253B5"; style="rounded";
    State [label="{EstadoPedidoState|interface|+estado(); +validarTransicion()}", fillcolor="#F4F0FF", color="#7253B5"];
    States [label="{Estados concretos|State|Pendiente; Confirmado; Preparando; Camino; Entregado; Cancelado}", fillcolor="#F4F0FF", color="#7253B5"];
    Publisher [label="{PedidoEventPublisher|Observer|+publicar(PedidoEvento)}", fillcolor="#F4F0FF", color="#7253B5"];
    Observer [label="{PedidoObserver|interface|+actualizar(PedidoEvento)}", fillcolor="#F4F0FF", color="#7253B5"];
    Observers [label="{Observadores concretos|HistorialObserver; NotificacionObserver}", fillcolor="#F4F0FF", color="#7253B5"];
    States -> State [arrowhead=empty, style=dashed, label="implementan"];
    Observers -> Observer [arrowhead=empty, style=dashed, label="implementan"];
    Publisher -> Observer [label="notifica *"];
  }

  PedidoService -> PedidoBuilder [label="usa"];
  PedidoService -> StateFactory [label="usa"];
  StateFactory -> State [label="entrega"];
  PedidoService -> Publisher [label="publica"];
  PedidoBuilder -> Pedido [label="construye"];
  States -> Pedido [label="valida estado", style=dashed];
  Publisher -> Historial [label="persiste", style=dashed];
}
